# Server
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5199
# Neon pooled connection for normal application traffic (-pooler hostname)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=verify-full
# Neon direct connection for schema migrations and SQLite imports
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=verify-full
DB_POOL_MAX=10
# Optional legacy source used by `npm run db:import:sqlite`
SQLITE_SOURCE_PATH=server/data/sovan.db
# Optional isolated branch used only by PostgreSQL store/gate tests
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
SESSION_DAYS=30
# Set to 1 when serving over HTTPS
COOKIE_SECURE=0

# Optional Neon Object Storage (S3-compatible, server-side only)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Owner account (upserted on every server start, always Pro forever)
ADMIN_EMAIL=Sithy@dev.pro
ADMIN_PASSWORD=Sithy123$$

# KHQR defaults used when the database is first created
KHQR_BAKONG_ID=
KHQR_MERCHANT_NAME=SOVANNAPHUMTRADE
KHQR_CITY=Phnom Penh
# 1 = allow the demo "I have paid" confirmation, 0 = require Bakong verification (default: 0)
ALLOW_DEMO_PAYMENTS=0

# Set to 1 to enable simulated Gmail/Telegram sign-in for local testing (default: 0)
ALLOW_SOCIAL_SIMULATION=0

# Real payment verification (Bakong Open API)
# Get a token from https://api-bakong.nbc.gov.kh/ with your registered Bakong account.
BAKONG_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
# Optional Python Pro Playbook Lab sidecar
PYTHON_RESEARCH_URL=http://127.0.0.1:8790
PYTHON_RESEARCH_HOST=127.0.0.1
PYTHON_RESEARCH_PORT=8790
